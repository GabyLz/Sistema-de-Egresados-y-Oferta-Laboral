# Example environment variables for production
# Neon (Postgres) connection string. Get from Neon dashboard.
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<db>?schema=public"
# Optional: Prisma shadow database for some migrate workflows (can be same DB or a separate Neon branch)
SHADOW_DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<shadow_db>?schema=public"
# JWT secret for signing tokens
JWT_SECRET="changeme"
# Redis (for bullmq). If not using, leave blank or provide RedisCloud/Render managed Redis.
REDIS_URL=redis://<host>:6379
# Public URL of the API (set in Render for the web service)
NEXT_PUBLIC_API_URL="https://egresados-api.onrender.com"
# Other optional storage / S3 settings
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
